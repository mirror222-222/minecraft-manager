[Unit]
Description=Minecraft idle monitor (auto-stop after inactivity)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/minecraftmanager
EnvironmentFile=-/etc/minecraft-manager/opnsense.env
ExecStart=/opt/minecraftmanager/.venv/bin/python /opt/minecraftmanager/actions/idle_monitor.py
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
