[Unit]
Description=Minecraft Manager Web UI
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/minecraftmanager
EnvironmentFile=-/etc/minecraft-manager/opnsense.env
ExecStart=/opt/minecraftmanager/.venv/bin/python /opt/minecraftmanager/main.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
